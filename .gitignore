!data/raw/.gitkeep
.env
.env.local
.next/
# The catalog itself IS checked in -- see README, "Running it". Only
# SQLite's transient sidecars are ignored; they are regenerated on open.
data/modbench.db-journal
data/modbench.db-shm
data/modbench.db-wal
data/raw/*.json
node_modules/
data/raw/images/

# 3D layered-preview prototype (scripts/3d-test): render output is hundreds
# of MB of generated PNG/WebP and is reproducible from the scripts. The two
# viewer pages live in out/ because they reference layers/ relatively, so
# they are kept; a few small sample renders are in scripts/3d-test/samples/.
__pycache__/
scripts/3d-test/out/*
!scripts/3d-test/out/index.html
!scripts/3d-test/out/layers.html
# ...except the textures the render pipeline loads (Git LFS; see .gitattributes).
!scripts/3d-test/out/dial-cut*.png
!scripts/3d-test/out/date*.png
!scripts/3d-test/out/ring*.png
!scripts/3d-test/out/insert*.png

# Render pipeline: public/render/layers (outputs + index.json) is committed,
# its PNGs via Git LFS; old build output dir below.
scripts/render/out/
