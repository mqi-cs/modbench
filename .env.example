# Copy to .env.local and fill in. Nothing here is required: without a model
# the site reads descriptions by keyword (lib/llm.ts).

# The model that reads "describe a watch" queries and photos (WS5).
# LLM_PROVIDER: anthropic (default) or openai-compatible
LLM_PROVIDER=anthropic
# Model id. anthropic defaults to claude-sonnet-5; required for openai-compatible.
LLM_MODEL=
# API key. For anthropic, ANTHROPIC_API_KEY works too.
LLM_API_KEY=
# openai-compatible only, e.g. https://api.openai.com/v1
LLM_BASE_URL=

# Evaluation (pnpm eval:describe): stop model calls past this spend, USD.
EVAL_MAX_USD=1
# Price per 1M tokens for a model the harness doesn't know (see scripts/eval-describe.ts).
EVAL_PRICE_IN_PER_M=
EVAL_PRICE_OUT_PER_M=

# Bring-your-own links (WS4): eBay Browse API.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
