{
  "name": "modbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "seed-exceptions": "tsx scripts/seed-exceptions.ts",
    "ingest": "tsx scripts/ingest.ts",
    "tag": "tsx scripts/tag-parts.ts",
    "import-tagged": "tsx scripts/import-tagged.ts",
    "review": "tsx scripts/review.ts",
    "merge-parts": "tsx scripts/merge-parts.ts",
    "backfill-attributes": "tsx scripts/backfill-attributes.ts",
    "backfill-images": "tsx scripts/backfill-images.ts",
    "backfill-style-tags": "tsx scripts/backfill-style-tags.ts",
    "prepare-assets": "tsx scripts/prepare-assets.ts",
    "draw-case-art": "tsx scripts/draw-case-art.ts",
    "verify-catalog": "tsx scripts/verify-catalog.ts",
    "catalog:rebuild": "pnpm db:migrate && pnpm seed && pnpm ingest && pnpm tag && pnpm import-tagged && pnpm seed-exceptions && pnpm backfill-attributes && pnpm backfill-images && pnpm backfill-style-tags && pnpm draw-case-art && pnpm prepare-assets && pnpm verify-catalog",
    "catalog:refresh": "pnpm tag && pnpm import-tagged && pnpm backfill-attributes && pnpm backfill-images && pnpm backfill-style-tags && pnpm draw-case-art && pnpm prepare-assets && pnpm verify-catalog",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "tsc --noEmit && vitest run && tsx scripts/verify-catalog.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "nanoid": "^6.0.1",
    "next": "^15.5.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}